# Community Sahayak AI - Environment Variables Reference
# ========================================================

# --- Backend Application Configuration ---
APP_NAME="Community Sahayak AI Backend"
API_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# --- Authentication & JWT Security ---
# Change this secret key in production!
SECRET_KEY="community-sahayak-super-secret-key-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google Sheets Database Integration (Optional, local mirror used if absent) ---
GOOGLE_SERVICE_ACCOUNT_FILE="credentials.json"
# Or provide the full JSON string directly (useful for cloud/Vercel):
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
GOOGLE_SHEET_ID="1rfT9LvjYD1FJQyqsVASVshZllne8lt1lEODQTgLqoIY"
GOOGLE_SHEET_NAME="MSME_Sahayak_Database"
GOOGLE_APPS_SCRIPT_URL=""

# --- AI & LLM Integrations (Optional, built-in intelligent synthesizer active by default) ---
# Add your Google Gemini API Key:
GEMINI_API_KEY=""
# Or OpenAI API Key:
OPENAI_API_KEY=""

# --- Frontend Configuration (Vite) ---
# In development, Vite proxies /api to http://localhost:8000
VITE_API_URL="/api"
